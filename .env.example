# Copy to .env (defaults/shared) and optionally .env.<TEST_ENV> for per-environment overrides.
# Precedence when tests run: .env.<TEST_ENV> > .env (see src/config/env.ts)

# ---- Which environment to run against ----
# One of: dev | staging | prod
TEST_ENV=dev

# ---- API base URLs per environment ----
# dev: the real Katbook backend (swagger.json only documents localhost, this is the actual host).
# Was http://192.168.1.74:2504 (a flaky internal LAN address); switched 2026-10-03 to the
# stable hosted endpoint below per explicit instruction.
DEV_API_BASE_URL=https://api1.katbook.com
STAGING_API_BASE_URL=
PROD_API_BASE_URL=

# ---- Request behavior ----
API_TIMEOUT_MS=30000

# ---- Test actor credentials (one set per login endpoint / role the suite exercises) ----
# Leave a role's credentials blank to have that role's tests skip instead of fail.
# NOTE: /v1/admin/login rejects an empty body with "Please enter phone Number or Email !."
# so the identifier field is a phone number or email address, not a free-form username.
ADMIN_USERNAME=
ADMIN_PASSWORD=
INSTITUTION_USERNAME=
INSTITUTION_PASSWORD=
# Both institution and user actors log in via InstitutionUserLogin, which (unlike every
# other actor here) requires a companyId in its body — a real InstitutionUser's companyId,
# not SEED.COMPANY_ID. No real InstitutionUser can currently be created via this API (see
# src/client/institution-user.client.ts), so this stays blank until that's fixed upstream.
INSTITUTION_COMPANY_ID=
USER_USERNAME=
USER_PASSWORD=
OFFLINE_USERNAME=
OFFLINE_PASSWORD=
# Internal staff (Content Uploader) account — logs in via /v1/content/user/login, not
# /v1/admin/login. Create it with `npm run bootstrap:content-uploader`.
CONTENT_UPLOADER_USERNAME=
CONTENT_UPLOADER_PASSWORD=

# ---- Bugzilla defect filing (leave blank to disable filing; framework still runs) ----
BUGZILLA_URL=
BUGZILLA_API_KEY=
BUGZILLA_PRODUCT=Katbook
BUGZILLA_COMPONENT=API
BUGZILLA_VERSION=1.0.0
BUGZILLA_DRY_RUN=true
