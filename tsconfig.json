{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@factories/*": ["src/factories/*"],
      "@client/*": ["src/client/*"],
      "@integrations/*": ["src/integrations/*"],
      "@utils/*": ["src/utils/*"]
    },
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "playwright.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "reports", "dist"]
}
