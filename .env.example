# Copy to .env (defaults/shared) and optionally .env.<TEST_ENV> for per-environment overrides.
# Precedence when tests run: .env.<TEST_ENV> > .env (see src/config/env.ts)

# ---- Which environment to run against ----
# One of: dev | staging | prod
TEST_ENV=dev

# ---- API base URLs per environment ----
# dev: the real Katbook backend (swagger.json only documents localhost, this is the actual host)
DEV_API_BASE_URL=http://192.168.1.74:2504
STAGING_API_BASE_URL=
PROD_API_BASE_URL=

# ---- Request behavior ----
API_TIMEOUT_MS=30000

# ---- Test actor credentials (one set per login endpoint / role the suite exercises) ----
# Leave a role's credentials blank to have that role's tests skip instead of fail.
# NOTE: /v1/admin/login rejects an empty body with "Please enter phone Number or Email !."
# so the identifier field is a phone number or email address, not a free-form username.
ADMIN_USERNAME=
ADMIN_PASSWORD=
INSTITUTION_USERNAME=
INSTITUTION_PASSWORD=
USER_USERNAME=
USER_PASSWORD=
OFFLINE_USERNAME=
OFFLINE_PASSWORD=

# ---- Bugzilla defect filing (leave blank to disable filing; framework still runs) ----
BUGZILLA_URL=
BUGZILLA_API_KEY=
BUGZILLA_PRODUCT=Katbook
BUGZILLA_COMPONENT=API
BUGZILLA_VERSION=1.0.0
BUGZILLA_DRY_RUN=true
